#!/usr/bin/env node
/**
 * script/test — Key diagram: vault occludes spokes
 *
 * Verifies that the interactive recovery diagram's vault icon is rendered
 * above/over the spoke lines, so lines appear to originate behind the vault.
 *
 * Two valid strategies (either is sufficient):
 *   A) CSS — .diagram-vault has z-index > 0 (spokes stay at auto/0).
 *   B) JS  — spokes are inserted via insertBefore(vault) / ordered behind vault
 *            instead of appendChild to [data-diagram-visual].
 *
 * Currently neither exists → test fails (proving the bug is present).
 */

'use strict';

const fs = require('fs');
const path = require('path');

const REPO = __dirname + '/..';

function read(p) {
  return fs.readFileSync(path.resolve(REPO, p), 'utf-8');
}

// ── CSS check ──────────────────────────────────────────────────────
const css = read('static/styles.css');

// .diagram-vault — must have a z-index >= 1 (spokes are auto/0).
const vaultBlock = css.match(/\.diagram-vault\s*\{[\s\S]*?\}/g);
let cssOk = false;
let cssReason = '';

if (!vaultBlock || vaultBlock.length === 0) {
  cssReason = '.diagram-vault CSS rule not found';
} else {
  const block = vaultBlock[0];
  const zMatch = block.match(/z-index\s*:\s*(\d+)/);
  if (!zMatch) {
    cssReason = '.diagram-vault has no z-index (spokes paint on top)';
  } else if (parseInt(zMatch[1], 10) < 1) {
    cssReason =
      '.diagram-vault z-index is ' + zMatch[1] + ' — must be ≥ 1';
  } else {
    cssOk = true;
  }
}

// ── JS check ───────────────────────────────────────────────────────
const js = read('static/js/key-diagram.js');

let jsOk = false;
let jsReason = '';

// Accept either strategy:
//   1) appendChild is not used for spokes (replaced by insertBefore with vault ref)
//   2) OR there's explicit z-index logic in JS

const hasAppendChild = js.includes('visual.appendChild(spoke)');
const hasInsertBeforeVault = /insertBefore\s*\([^)]*vault/i.test(js);
const hasZIndexLogic = /z-?index/i.test(js);

if (!hasAppendChild && hasInsertBeforeVault) {
  jsOk = true;
} else if (hasZIndexLogic) {
  jsOk = true;
} else if (!hasAppendChild) {
  jsOk = true; // no appendChild and some other strategy
} else {
  jsReason =
    'static/js/key-diagram.js uses visual.appendChild(spoke), placing spokes ' +
    'after the vault node in DOM order (spokes paint on top)';
}

// ── Verdict ────────────────────────────────────────────────────────
const passed = cssOk || jsOk;

if (!passed) {
  const reasons = [];
  if (!cssOk) reasons.push('CSS: ' + cssReason);
  if (!jsOk) reasons.push('JS: ' + jsReason);

  console.log('FAIL: vault does NOT occlude spokes');
  console.log('');
  reasons.forEach(function (r) { console.log('  • ' + r); });
  console.log('');
  console.log('Expected: vault icon renders above/over spoke lines.');
  console.log('Fix options:');
  console.log('  A) Add z-index: 1 to .diagram-vault in styles.css');
  console.log(
    '  B) Replace visual.appendChild(spoke) with insertBefore relative to vault node'
  );
  process.exit(1);
} else {
  console.log('PASS: vault occludes spokes');
  process.exit(0);
}